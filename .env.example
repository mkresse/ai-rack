# copy to .env

ANTHROPIC_API_KEY=<anthropic api key>
MISTRAL_API_KEY=<mistral api key>

LITELLM_MASTER_KEY=<litellm master api key>
LITELLM_SALT_KEY=<litellm encryption salt>

POSTGRES_PASS=<db password for superuser>
OWUI_DB_PASS=<db password for open webui>
LITELLM_DB_PASS=<db password for litellm>

# caddy settings (home-server overlay only, docker-compose.homeserver.yml)
CADDY_MACVLAN_PARENT=<host NIC for macvlan, e.g. eth0>
CADDY_MACVLAN_SUBNET=<LAN subnet, e.g. 192.168.1.0/24>
CADDY_MACVLAN_GATEWAY=<LAN gateway, e.g. 192.168.1.1>

CADDY_DOMAIN=<public domain caddy serves, e.g. myowui.com>
CADDY_IP=<caddy macvlan LAN IP, e.g. 192.168.1.200>
CADDY_ACME_DELEGATION_ZONE=<acme delegation zone for dns-01, e.g. myacmezone.com>
HETZNER_API_TOKEN=<hetzner dns api token for caddy tls management>
